# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# Modelo de lenguaje (TES-11)
OPENAI_API_KEY=
MODELO_LLM=

# Base de datos
DATABASE_URL=postgresql://gemela:gemela@postgres:5432/gemela

# Sesión (cadena larga y aleatoria)
SECRETO_SESION=cambia-esto-por-una-cadena-aleatoria

# URL pública de la interfaz (para los retornos OAuth)
URL_BASE=http://localhost:8000

# OAuth: con uno basta para la demo (TES-9)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL pública del servidor MCP, la del túnel (TES-21)
URL_MCP_PUBLICA=http://localhost:8001
